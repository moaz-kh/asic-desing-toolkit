# Simulation Makefile for __DESIGN_NAME__
# Generated by the ASIC Design Toolkit. Run `make help` for the commands.

DESIGN  := __DESIGN_NAME__
TB      := $(DESIGN)_tb

RTL_DIR  := rtl
TB_DIR   := tb
SIM_DIR  := sim
WAVE_DIR := $(SIM_DIR)/waves

RTL_SRCS := $(wildcard $(RTL_DIR)/*.v) $(wildcard $(RTL_DIR)/lib/*.v)
TB_SRCS  := $(wildcard $(TB_DIR)/*.v)

IVERILOG := iverilog
VVP      := vvp
GTKWAVE  := gtkwave

SIM_BIN  := $(SIM_DIR)/$(DESIGN).vvp
VCD      := $(WAVE_DIR)/$(DESIGN).vcd
GTKW     := $(WAVE_DIR)/$(DESIGN).gtkw

.PHONY: help
help:
	@echo "========================================"
	@echo "The 3 commands you need"
	@echo "========================================"
	@echo "  make sim          Compile and run simulation"
	@echo "  make waves        Open GTKWave to view waveforms"
	@echo "  make sim-waves    Simulate then open waveforms (most common)"
	@echo ""
	@echo "========================================"
	@echo "Utilities"
	@echo "========================================"
	@echo "  make save-session Save current GTKWave signal layout"
	@echo "  make check-tools  Verify required tools are installed"
	@echo "  make status       Show what has run"
	@echo "  make clean        Remove simulation outputs"

.PHONY: sim
sim: $(VCD)

$(VCD): $(RTL_SRCS) $(TB_SRCS)
	@mkdir -p $(WAVE_DIR)
	$(IVERILOG) -g2012 -o $(SIM_BIN) -s $(TB) $(RTL_SRCS) $(TB_SRCS)
	$(VVP) $(SIM_BIN)
	@echo ""
	@echo "Waveform written to $(VCD)"

.PHONY: waves
waves:
	@test -f $(VCD) || { echo "No waveform yet - run 'make sim' first."; exit 1; }
	@if [ -f $(GTKW) ]; then $(GTKWAVE) $(GTKW) >/dev/null 2>&1 & \
	 else $(GTKWAVE) $(VCD) >/dev/null 2>&1 & fi

.PHONY: sim-waves
sim-waves: sim waves

.PHONY: save-session
save-session:
	@echo "In GTKWave: File > Write Save File"
	@echo "Save it as: $(GTKW)"
	@echo "Then 'make waves' reloads your signal layout automatically."

.PHONY: check-tools
check-tools:
	@for t in $(IVERILOG) $(VVP) $(GTKWAVE); do \
		if command -v $$t >/dev/null 2>&1; then echo "  OK    $$t"; \
		else echo "  MISS  $$t  (run install_asic_tools.sh --mode=sim)"; fi; \
	done

.PHONY: status
status:
	@echo "Design : $(DESIGN)"
	@echo "RTL    : $(words $(RTL_SRCS)) file(s)"
	@echo "TB     : $(words $(TB_SRCS)) file(s)"
	@if [ -f $(VCD) ]; then echo "Sim    : done -> $(VCD)"; \
	 else echo "Sim    : not run"; fi

.PHONY: clean
clean:
	rm -f $(SIM_DIR)/*.vvp $(WAVE_DIR)/*.vcd
	@echo "Simulation outputs removed."
