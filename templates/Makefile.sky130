# ASIC Makefile for __DESIGN_NAME__ (Sky130)
# Generated by the ASIC Design Toolkit. Run `make help` for the commands.

DESIGN  := __DESIGN_NAME__
TB      := $(DESIGN)_tb

RTL_DIR  := rtl
TB_DIR   := tb
SIM_DIR  := sim
WAVE_DIR := $(SIM_DIR)/waves
CONFIG   := config/config.json

RTL_SRCS := $(wildcard $(RTL_DIR)/*.v) $(wildcard $(RTL_DIR)/lib/*.v)
TB_SRCS  := $(wildcard $(TB_DIR)/*.v)

IVERILOG := iverilog
VVP      := vvp
GTKWAVE  := gtkwave

SIM_BIN  := $(SIM_DIR)/$(DESIGN).vvp
VCD      := $(WAVE_DIR)/$(DESIGN).vcd
GTKW     := $(WAVE_DIR)/$(DESIGN).gtkw

# OpenLane 2, dockerized. PDK is installed by install_asic_tools.sh --mode=full.
PDK_ROOT ?= $(HOME)/.asic-toolkit/pdks
OPENLANE := openlane --dockerized --pdk-root $(PDK_ROOT)

.PHONY: help
help:
	@echo "========================================"
	@echo "The 5 commands you need"
	@echo "========================================"
	@echo "  make sim          Compile and run simulation"
	@echo "  make waves        Open GTKWave to view waveforms"
	@echo "  make sim-waves    Simulate then open waveforms (most common)"
	@echo "  make synth        Synthesize RTL -> netlist (Sky130)"
	@echo "  make gds          Full RTL -> GDSII flow (Sky130)"
	@echo ""
	@echo "========================================"
	@echo "Flow step-by-step"
	@echo "========================================"
	@echo "  make floorplan    Run up to floorplan step"
	@echo "  make place        Run up to placement step"
	@echo "  make route        Run up to routing step"
	@echo ""
	@echo "========================================"
	@echo "View results"
	@echo "========================================"
	@echo "  make view-gds     Open the GDSII layout in KLayout"
	@echo "  make timing       Print timing summary from the last run"
	@echo "  make area         Print area summary from the last run"
	@echo ""
	@echo "========================================"
	@echo "Utilities"
	@echo "========================================"
	@echo "  make save-session Save current GTKWave signal layout"
	@echo "  make check-tools  Verify required tools are installed"
	@echo "  make status       Show what has run"
	@echo "  make clean        Remove simulation outputs"
	@echo "  make clean-runs   Remove OpenLane run dirs (keeps GDS)"
	@echo "  make clean-all    Remove everything generated"

# --- Simulation ------------------------------------------------------------
.PHONY: sim
sim: $(VCD)

$(VCD): $(RTL_SRCS) $(TB_SRCS)
	@mkdir -p $(WAVE_DIR)
	$(IVERILOG) -g2012 -o $(SIM_BIN) -s $(TB) $(RTL_SRCS) $(TB_SRCS)
	$(VVP) $(SIM_BIN)
	@echo ""
	@echo "Waveform written to $(VCD)"

.PHONY: waves
waves:
	@test -f $(VCD) || { echo "No waveform yet - run 'make sim' first."; exit 1; }
	@if [ -f $(GTKW) ]; then $(GTKWAVE) $(GTKW) >/dev/null 2>&1 & \
	 else $(GTKWAVE) $(VCD) >/dev/null 2>&1 & fi

.PHONY: sim-waves
sim-waves: sim waves

# --- OpenLane 2 flow -------------------------------------------------------
.PHONY: synth
synth:
	$(OPENLANE) --to Yosys.Synthesis $(CONFIG)

.PHONY: gds
gds:
	$(OPENLANE) $(CONFIG)

.PHONY: floorplan
floorplan:
	$(OPENLANE) --to OpenROAD.Floorplan $(CONFIG)

.PHONY: place
place:
	$(OPENLANE) --to OpenROAD.DetailedPlacement $(CONFIG)

.PHONY: route
route:
	$(OPENLANE) --to OpenROAD.DetailedRouting $(CONFIG)

# --- View results ----------------------------------------------------------
.PHONY: view-gds
view-gds:
	$(OPENLANE) --last-run --flow openinklayout $(CONFIG)

.PHONY: timing
timing:
	@f=$$(find runs -path '*summary*' -name '*.rpt' 2>/dev/null | tail -1); \
	if [ -n "$$f" ]; then grep -iE 'slack|tns|wns' "$$f" || cat "$$f"; \
	else echo "No timing report found - run 'make route' or 'make gds' first."; fi

.PHONY: area
area:
	@f=$$(find runs -name '*area*' 2>/dev/null | tail -1); \
	if [ -n "$$f" ]; then cat "$$f"; \
	else echo "No area report found - run 'make gds' first."; fi

# --- Utilities -------------------------------------------------------------
.PHONY: save-session
save-session:
	@echo "In GTKWave: File > Write Save File"
	@echo "Save it as: $(GTKW)"
	@echo "Then 'make waves' reloads your signal layout automatically."

.PHONY: check-tools
check-tools:
	@for t in $(IVERILOG) $(VVP) $(GTKWAVE); do \
		if command -v $$t >/dev/null 2>&1; then echo "  OK    $$t"; \
		else echo "  MISS  $$t  (run install_asic_tools.sh)"; fi; \
	done
	@if command -v openlane >/dev/null 2>&1; then echo "  OK    openlane"; \
	 else echo "  MISS  openlane  (run install_asic_tools.sh --mode=full)"; fi
	@if [ -d $(PDK_ROOT)/sky130A ]; then echo "  OK    sky130 PDK"; \
	 else echo "  MISS  sky130 PDK  (run install_asic_tools.sh --mode=full)"; fi

.PHONY: status
status:
	@echo "Design : $(DESIGN)"
	@echo "RTL    : $(words $(RTL_SRCS)) file(s)"
	@if [ -f $(VCD) ]; then echo "Sim    : done"; else echo "Sim    : not run"; fi
	@if [ -d runs ]; then echo "Flow   : $$(ls -1 runs 2>/dev/null | wc -l) run(s) in runs/"; \
	 else echo "Flow   : not run"; fi

.PHONY: clean
clean:
	rm -f $(SIM_DIR)/*.vvp $(WAVE_DIR)/*.vcd
	@echo "Simulation outputs removed."

.PHONY: clean-runs
clean-runs:
	rm -rf runs
	@echo "OpenLane run directories removed."

.PHONY: clean-all
clean-all: clean clean-runs
	@echo "All generated files removed."
